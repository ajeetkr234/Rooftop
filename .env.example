# Production & Development Environment Configuration
# Duplicate this file to .env and customize for your environment.

# Server Port
PORT=5000
NODE_ENV=development

# Optional Frontend Whitelisted URL for CORS
CLIENT_ORIGIN=http://localhost:3000

# Optional MongoDB Database Connection String
# If left blank, the server automatically defaults to filesystem JSON persistence.
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/rooftop?retryWrites=true&w=majority

# Optional SMTP Notification Dispatch (Placeholder)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@yourroofingcompany.example.com
# SMTP_PASS=your-secure-smtp-password
# LEAD_NOTIFICATION_EMAIL=inquiries@yourroofingcompany.example.com

